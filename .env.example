# Copy to .env to override defaults (docker compose reads it automatically).
POSTGRES_PASSWORD=change-me

# Binoculars model pair (must share a tokenizer). Re-run scripts/calibrate.py after changing.
OBSERVER_MODEL=Qwen/Qwen2.5-0.5B
PERFORMER_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Keep submitted text in the database (default: only scores and a hash are stored).
STORE_TEXT=false

# AI humanizer. The local backend reads this file too.
#   local  = free model run by Ollama on this machine (install Ollama, then: ollama pull qwen3:4b-instruct)
#   claude = Claude API: better, but paid per use, and the text is sent to Anthropic
#   off    = no humanizer
HUMANIZER_ENGINE=local
HUMANIZER_LOCAL_MODEL=qwen3:4b-instruct
# Ollama on the host. From inside Docker it is reached as host.docker.internal (set in docker-compose.yml).
# OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
HUMANIZER_MODEL=claude-opus-5-5
HUMANIZER_EFFORT=medium

# Host ports. Change them if 3000 or 8000 is already taken on your machine.
WEB_PORT=3000
API_PORT=8000
